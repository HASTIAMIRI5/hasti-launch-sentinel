[project]
name = "hasti-launch-sentinel"
version = "1.0.0"
description = "AI product launch tracker and risk detector"
readme = "README.md"
requires-python = ">=3.12"
dependencies = [
  "fastapi==0.115.0",
  "uvicorn[standard]==0.30.6",
  "pydantic==2.9.2",
]

[tool.pytest.ini_options]
pythonpath = "."
